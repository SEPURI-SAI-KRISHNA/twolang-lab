# Python virtual environments
.venv/
.venv-ft/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Jupyter/JShell kernel scratch
mima_cache/
tools/java-kernel/

# IDE
.idea/

# Permanent, complete progress record -- INDEX.md and relations.json (committed) are
# trimmed snapshots of these, generated by tools/release.mjs, reflecting only topics
# actually released so far. These "full" files stay local until you're ready to reveal
# everything (see tools/release.mjs).
INDEX.full.md
relations.full.json

# Batch generator scripts contain full inline source for every topic in that batch --
# don't commit one until every topic in it has been released. Safe once fully released.
tools/gen_batch*.py
tools/fix_*.py

# Node / Next.js (web app lives in web/)
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/*.tsbuildinfo
web/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS cruft
.DS_Store
*.pem

# env files
.env
.env.*
